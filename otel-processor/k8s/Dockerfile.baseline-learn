# Dockerfile.baseline-learn
# Pre-baked image for the baseline-learn CronJob.
# Contains Python 3.11 + kubectl so the job starts in seconds
# instead of spending 45s downloading kubectl on every run.
FROM python:3.11-slim

# Install kubectl
RUN apt-get update -qq && apt-get install -y -qq curl ca-certificates && \
    curl -sLO "https://dl.k8s.io/release/$(curl -sL https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl" && \
    chmod +x kubectl && mv kubectl /usr/local/bin/ && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

# Pre-install Python deps so the job doesn't need internet at runtime
RUN pip install --no-cache-dir requests python-dotenv

WORKDIR /repo
